# Tidak boleh melihat daftar isi folder
Options -Indexes

# File tersembunyi / cadangan / konfigurasi tidak boleh diunduh
<FilesMatch "(^\.|\.(bak|old|orig|sql|log|ini|inc|sh|md|zip|tar|gz)$|~$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Tolak "../" dan byte NUL di alamat
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} (\.\./|%2e%2e|%00) [NC]
    RewriteRule ^ - [F,L]
</IfModule>